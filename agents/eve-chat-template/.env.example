# Hosted starter mode. Use a strong password (16+ characters recommended).
EVE_CHAT_PASSWORD=

# Required for hosted password sign-in and database-backed production mode.
# Use ONE complete pair. Local next dev outside Vercel can omit Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative pair:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional production identity and cross-browser persistence upgrade.
# Configure all four values below plus a Redis pair above.
DATABASE_URL=
BETTER_AUTH_SECRET=
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# Optional: override the app origin for a custom production domain.
BETTER_AUTH_URL=

# Optional: enable hosted Vercel Connect integrations.
SLACK_CONNECTOR=
LINEAR_CONNECTOR=
NOTION_CONNECTOR=
SENTRY_CONNECTOR=
