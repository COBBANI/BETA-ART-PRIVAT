# Derlemeye yüklenmeyecek kaynaklar. Tarayıcıya yalnız dist/ sunulur.
engine/
scripts/*
!scripts/vercel-build.sh
dist/
# Inter'in resmi dağıtımı — 60 MB, hak paketi kanıtı. Site alt kümeleri
# assets/fonts/ altından yüklüyor; bu klasörün yayına çıkması gereksiz
# yük ve gereksiz bir yeniden dağıtımdır.
vendor/
docs/
content/
node_modules/
*.md
!assets/**/*.md
package.json
package-lock.json
.github/
