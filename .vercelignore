# Yayına çıkmayacaklar: motor, betikler, dokümanlar, türev içerik kaynakları.
# Site saf statik; bunların hiçbiri tarayıcıya gitmiyor.
engine/
scripts/*
!scripts/build-static.mjs
!scripts/vercel-build.sh
